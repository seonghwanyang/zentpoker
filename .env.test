# Test Environment Configuration
NODE_ENV=test

# Application URLs
NEXT_PUBLIC_APP_URL=http://localhost:3001
NEXTAUTH_URL=http://localhost:3001

# NextAuth Configuration
NEXTAUTH_SECRET=test-secret-key-for-development-only

# Test Database URL
# Replace with your actual test database URL
DATABASE_URL_TEST=postgresql://username:password@localhost:5432/zentpoker_test

# Google OAuth (Test)
GOOGLE_CLIENT_ID=test-google-client-id
GOOGLE_CLIENT_SECRET=test-google-client-secret

# Naver OAuth (Test)
NAVER_CLIENT_ID=test-naver-client-id
NAVER_CLIENT_SECRET=test-naver-client-secret

# Kakao OAuth (Test)
KAKAO_CLIENT_ID=test-kakao-client-id
KAKAO_CLIENT_SECRET=test-kakao-client-secret

# KakaoPay (Test)
KAKAO_PAY_CID=test-kakao-pay-cid
KAKAO_PAY_SECRET=test-kakao-pay-secret

# Test Configuration
SKIP_DATABASE_MIGRATION=true
DISABLE_RATE_LIMITING=true
ENABLE_MOCK_SERVICES=true

# Jest Configuration
JEST_TIMEOUT=30000

# Playwright Configuration
PLAYWRIGHT_TIMEOUT=30000
PLAYWRIGHT_BASE_URL=http://localhost:3001

# Logging
LOG_LEVEL=error
DISABLE_CONSOLE_LOG=true

# Email Service (Test)
EMAIL_FROM=test@example.com
EMAIL_SERVER_HOST=localhost
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=test
EMAIL_SERVER_PASSWORD=test

# Test Data Configuration
TEST_USER_EMAIL=test@example.com
TEST_ADMIN_EMAIL=admin@example.com
TEST_USER_PASSWORD=test123456

# Feature Flags for Testing
ENABLE_TOURNAMENT_FEATURES=true
ENABLE_VOUCHER_FEATURES=true
ENABLE_PAYMENT_FEATURES=true